{
  "name": "bgapp-front",
  "jest": {
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/index.tsx"
    ],
    "coverageReporters": [
      "text"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/assetsTransformer.ts",
      "\\.(css|less)$": "<rootDir>/assetsTransformer.ts"
    }
  },
  "version": "0.1.0",
  "private": true,
  "homepage": "https://tselouie.github.io/TheBoardgameApp-front",
  "dependencies": {
    "@emotion/react": "^11.14.0",
