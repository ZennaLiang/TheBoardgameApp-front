    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mui/icons-material": "^7.3.2",
    "@mui/lab": "^7.0.0-beta.14",
    "@mui/material": "^7.2.0",
    "axios": "^1.10.0",
    "bootstrap": "^5.3.7",
    "cors-anywhere": "^0.4.4",
    "date-fns": "^4.1.0",
    "formik": "^2.4.6",
    "google-auth-library": "^10.1.0",
    "gsap": "^3.13.0",
    "in-view": "^0.6.1",
    "jquery": "^3.7.1",
    "match-sorter": "^8.0.3",
    "moment": "^2.30.1",
    "react": "^18.0.0",
    "react-big-calendar": "^1.19.4",
    "react-bootstrap": "^2.10.10",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.0.0",
    "react-loader-spinner": "^6.1.6",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.6.3",
    "react-scripts": "^5.0.1",
    "react-select": "^5.10.1",
    "react-table": "^7.8.0",
    "reactstrap": "^9.2.3",
    "sass": "^1.89.2",
