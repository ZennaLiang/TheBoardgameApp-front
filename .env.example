# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# WebSocket server URL for chat
VITE_CHAT_URL=http://localhost:8000

# Interval in ms for chat polling (optional)
VITE_CHAT_REFRESH=3000

# BoardGame Atlas API (https://www.boardgameatlas.com/api/docs)
VITE_BOARDGAME_ATLAS_API_URL=https://api.boardgameatlas.com/api
VITE_BOARDGAME_ATLAS_CLIENT_ID=your_client_id_here

# Google OAuth client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Facebook App ID
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
